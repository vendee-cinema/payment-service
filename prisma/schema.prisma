generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Payment {
  id String @id @default(nanoid())

  amount     Float
  status     PaymentStatus @default(PENDING)
  providerId String?       @map("provider_id")
  metadata   Json?

  userId String @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("payments")
}

model PaymentMethod {
  id String @id @default(nanoid())

  type   String
  status PaymentMethodStatus @default(PENDING)
  mask   String
  bank   String?
  brand  String?
  ip     String?

  userId     String  @map("user_id")
  providerId String? @map("provider_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("payment_methods")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED

  @@map("payment_status")
}

enum PaymentMethodStatus {
  PENDING
  ACTIVE

  @@map("payment_method_status")
}
