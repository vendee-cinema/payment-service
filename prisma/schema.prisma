generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Order {
  id String @id @default(nanoid())

  providerPaymentId String?          @map("provider_payment_id")
  provider          PaymentProvider?

  amount Float
  status PaymentStatus @default(PENDING)

  metadata Json?

  userId String @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("payments")
}

model PaymentMethod {
  id String @id @default(nanoid())

  type   String
  status PaymentMethodStatus @default(PENDING)
  mask   String
  bank   String?
  brand  String?
  ip     String?
  token  String?

  userId String @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("payment_methods")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED

  @@map("payment_status")
}

enum PaymentMethodStatus {
  PENDING
  ACTIVE

  @@map("payment_method_status")
}

enum PaymentProvider {
  LIQPAY

  @@map("payment_provider")
}
